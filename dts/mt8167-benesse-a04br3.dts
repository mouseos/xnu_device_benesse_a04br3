/dts-v1/;

/ {
	model = "MT8167";
	compatible = "mediatek,mt8167";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;

	aliases {
		serial0 = "/soc/uart0@11005000";
		aal0 = &aal;
		ccorr0 = &ccorr;
		color0 = &color;
		dither0 = &dither;
		dsi0 = &dsi;
		gamma0 = &gamma;
		ovl0 = &ovl0;
		rdma0 = &rdma0;
		rdma1 = &rdma1;
		wdma0 = &wdma;
	};

	atf_logger {
		compatible = "mediatek,atf_logger";
		interrupts = <0x00 0xdd 0x01>;
	};

	opp_table0 {
		compatible = "operating-points-v2";
		opp-shared;
		linux,phandle = <0x07>;
		phandle = <0x07>;

		opp00 {
			opp-hz = <0x00 0x23a4c180>;
			opp-microvolt = <1300000>;
		};

		opp01 {
			opp-hz = <0x00 0x2c8df1e0>;
			opp-microvolt = <1300000>;
		};

		opp02 {
			opp-hz = <0x00 0x3dfd2400>;
			opp-microvolt = <1300000>;
		};

		opp03 {
			opp-hz = <0x00 0x47498300>;
			opp-microvolt = <1300000>;
		};

		opp04 {
			opp-hz = <0x00 0x4d7c6d00>;
			opp-microvolt = <1300000>;
		};
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a35";
			reg = <0x00>;
			enable-method = "psci";
			clocks = <0x04 0x00>, <&topckgen 0x04>;
			clock-names = "cpu", "intermediate";
			operating-points-v2 = <0x07>;
			clock-frequency = "M|m";
			proc-supply = <&a04_vproc_fixed>;
			linux,phandle = <0x09>;
			phandle = <0x09>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a35";
			reg = <0x01>;
			enable-method = "psci";
			clocks = <0x04 0x00>, <&topckgen 0x04>;
			clock-names = "cpu", "intermediate";
			operating-points-v2 = <0x07>;
			clock-frequency = "M|m";
			proc-supply = <&a04_vproc_fixed>;
			linux,phandle = <0x0a>;
			phandle = <0x0a>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a35";
			reg = <0x02>;
			enable-method = "psci";
			clocks = <0x04 0x00>, <&topckgen 0x04>;
			clock-names = "cpu", "intermediate";
			operating-points-v2 = <0x07>;
			clock-frequency = "M|m";
			proc-supply = <&a04_vproc_fixed>;
			linux,phandle = <0x0b>;
			phandle = <0x0b>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a35";
			reg = <0x03>;
			enable-method = "psci";
			clocks = <0x04 0x00>, <&topckgen 0x04>;
			clock-names = "cpu", "intermediate";
			operating-points-v2 = <0x07>;
			clock-frequency = "M|m";
			proc-supply = <&a04_vproc_fixed>;
			linux,phandle = <0x0c>;
			phandle = <0x0c>;
		};

		idle-states {
			entry-method = "arm,psci";

			cpu-sleep-0-0 {
				compatible = "arm,idle-state";
				local-timer-stop;
				arm,psci-suspend-param = <0x10000>;
				entry-latency-us = <0x258>;
				exit-latency-us = <0x258>;
				min-residency-us = <0x4b0>;
				linux,phandle = <0x03>;
				phandle = <0x03>;
			};

			cluster-sleep-0 {
				compatible = "arm,idle-state";
				local-timer-stop;
				arm,psci-suspend-param = <0x2010000>;
				entry-latency-us = <0x320>;
				exit-latency-us = <0x3e8>;
				min-residency-us = <0x7d0>;
				linux,phandle = <0x02>;
				phandle = <0x02>;
			};
		};
	};

	thermal-zones {
		cpu-thermal {
			polling-delay-passive = <250>;
			polling-delay = <1000>;
			thermal-sensors = <&a04_thermal 0>;

			trips {
				cpu_alert: cpu-alert {
					temperature = <85000>;
					hysteresis = <5000>;
					type = "passive";
				};

				cpu_critical: cpu-critical {
					temperature = <117000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};
		};

		mfg-thermal {
			polling-delay-passive = <250>;
			polling-delay = <1000>;
			thermal-sensors = <&a04_thermal 1>;

			trips {
				mfg_critical: mfg-critical {
					temperature = <117000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};
		};

		gpu-thermal {
			polling-delay-passive = <250>;
			polling-delay = <1000>;
			thermal-sensors = <&a04_thermal 2>;

			trips {
				gpu_critical: gpu-critical {
					temperature = <117000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};
		};
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		framebuffer_reserved: framebuffer@be9c0000 {
			reg = <0x00 0xbe9c0000 0x00 0x1000000>;
			no-map;
		};

		atf-reserved-memory@43000000 {
			compatible = "mediatek,mt8167-atf-reserved-memory";
			no-map;
			reg = <0x00 0x43000000 0x00 0x30000>;
		};

		ram_console-reserved-memory@44400000 {
			compatible = "mediatek,ram_console";
			reg = <0x00 0x44400000 0x00 0x10000>;
		};

		pstore-reserved-memory@44410000 {
			compatible = "mediatek,pstore";
			reg = <0x00 0x44410000 0x00 0xe0000>;
		};

		minirdump-reserved-memory@444f0000 {
			compatible = "mediatek,minirdump";
			reg = <0x00 0x444f0000 0x00 0x10000>;
		};

		audio_dma_pool: audio-dma-pool@5c000000 {
			compatible = "shared-dma-pool";
			reg = <0x00 0x5c000000 0x00 0x400000>;
			no-map;
		};

		consys-reserve-memory {
			compatible = "mediatek,consys-reserve-memory";
			no-map;
			size = <0x00 0x200000>;
			alignment = <0x00 0x200000>;
		};
	};

	pmu {
		compatible = "arm,cortex-a35-pmu";
		interrupts = <0x00 0x04 0x08 0x00 0x05 0x08 0x00 0x06 0x08 0x00 0x07 0x08>;
		interrupt-affinity = <0x09 0x0a 0x0b 0x0c>;
	};

	psci {
		compatible = "arm,psci-0.2";
		method = "smc";
	};

	clocks {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "simple-bus";
		ranges;

		a04_mipi_ref: clk26m {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x18cba80>;
		};

		clk32k {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x7d00>;
			linux,phandle = <0x0e>;
			phandle = <0x0e>;
		};

		a04_pwrap_26m: dummy26m {
			compatible = "fixed-clock";
			clock-frequency = <0x18cba80>;
			#clock-cells = <0x00>;
		};

		a04_msdc0_clocks: msdc0-clock-controller {
			compatible = "benesse,a04br3-mt8167-msdc-clock";
			mediatek,topckgen = <0x05>;
			#clock-cells = <0x01>;
		};

		a04_audio_clock: audio-clock-controller {
			compatible = "benesse,a04br3-mt8167-audio-clock";
			mediatek,topckgen = <0x05>;
			#clock-cells = <0x01>;
		};

		a04_usb_clocks: usb-clock-controller {
			compatible = "benesse,a04br3-mt8167-usb-clock";
			mediatek,topckgen = <0x05>;
			#clock-cells = <0x01>;
		};

		a04_i2c1_clock: i2c1-clock-controller {
			compatible = "benesse,a04br3-mt8167-i2c-clock";
			mediatek,topckgen = <0x05>;
			#clock-cells = <0x01>;
		};

		a04_msdc1_source: msdc1-source-clock {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <188000000>;
		};

		a04_msdc1_hclk: msdc1-hclk {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <188000000>;
		};

		a04_msdc1_source_cg: msdc1-source-gate {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <188000000>;
		};

		a04_uart0_baud: uart0-baud-clock {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <26000000>;
		};

		a04_uart0_bus: uart0-bus-clock {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <26000000>;
		};

		a04_i2c0_main: i2c0-main-clock {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <68250000>;
		};

		a04_apdma: apdma-clock {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <136500000>;
		};

	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <0x0d>;
		interrupts = <0x01 0x0d 0xf08 0x01 0x0e 0xf08 0x01 0x0b 0xf08 0x01 0x0a 0xf08>;
		clock-frequency = <0xc65d40>;
	};

	soc {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "simple-bus";
		ranges;

		chipid@08000000 {
			compatible = "mediatek,chipid";
			reg = <0x00 0x8000000 0x00 0x04 0x00 0x8000004 0x00 0x04 0x00 0x8000008 0x00 0x04 0x00 0x800000c 0x00 0x04>;
		};

		topckgen: topckgen@10000000 {
			compatible = "mediatek,mt8167-topckgen", "syscon";
			reg = <0x00 0x10000000 0x00 0x1000>;
			#clock-cells = <0x01>;
			linux,phandle = <0x05>;
			phandle = <0x05>;
		};

		infracfg@10001000 {
			compatible = "mediatek,mt8167-infracfg\0syscon";
			reg = <0x00 0x10001000 0x00 0x1000>;
			#clock-cells = <0x01>;
			linux,phandle = <0x04>;
			phandle = <0x04>;
		};

		btcvsd@10001000 {
			compatible = "mediatek,audio_bt_cvsd";
			offset = <0xc00 0x02 0xfd0 0xfd4 0xfd8>;
			reg = <0x00 0x10001000 0x00 0x1000 0x00 0x18000000 0x00 0x10000 0x00 0x18080000 0x00 0x8000>;
			interrupts = <0x00 0xc2 0x08>;
		};

		mt_soc_btcvsd_rx_pcm@10001000 {
			compatible = "mediatek,mt_soc_btcvsd_rx_pcm";
		};

		mt_soc_btcvsd_tx_pcm@10001000 {
			compatible = "mediatek,mt_soc_btcvsd_tx_pcm";
		};

		syscfg_pctl_a@10005000 {
			compatible = "mediatek,mt8167-pctl-a-syscfg\0syscon";
			reg = <0x00 0x10005000 0x00 0x1000>;
			linux,phandle = <0x0f>;
			phandle = <0x0f>;
		};

		toprgu@10007000 {
			compatible = "mediatek,mt8167-wdt\0mediatek,mt6589-wdt";
			reg = <0x00 0x10007000 0x00 0x1000>;
			#reset-cells = <0x01>;
			linux,phandle = <0x44>;
			phandle = <0x44>;
		};

		timer@10008000 {
			compatible = "mediatek,mt8167-timer\0mediatek,mt6577-timer";
			reg = <0x00 0x10008000 0x00 0x1000>;
			interrupts = <0x00 0x84 0x08>;
			clocks = <0x05 0x32 0x0e 0x05 0x5a>;
			clock-names = "clk13m\0clk32k\0bus";
		};

		pinctrl@10005000 {
			compatible = "mediatek,mt8167-pinctrl";
			reg = <0x00 0x1000b000 0x00 0x1000>;
			mediatek,pctl-regmap = <0x0f>;
			pins-are-numbered;
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			interrupts = <0x00 0x86 0x04>;
			pinctrl-names = "default";
			pinctrl-0 = <0x10>;
			linux,phandle = <0x12>;
			phandle = <0x12>;

			uart0gpiodefault {
				linux,phandle = <0x17>;
				phandle = <0x17>;
			};

			uart0_rx_set {
				linux,phandle = <0x18>;
				phandle = <0x18>;

				pins_cmd_dat {
					pinmux = <0x3e01>;
				};
			};

			uart0_rx_clear {
				linux,phandle = <0x19>;
				phandle = <0x19>;

				pins_cmd_dat {
					pinmux = <0x3e00>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			uart0_tx_set {
				linux,phandle = <0x1a>;
				phandle = <0x1a>;

				pins_cmd_dat {
					pinmux = <0x3f01>;
				};
			};

			uart0_tx_clear {
				linux,phandle = <0x1b>;
				phandle = <0x1b>;

				pins_cmd_dat {
					pinmux = <0x3f00>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			uart1gpiodefault {
				linux,phandle = <0x1c>;
				phandle = <0x1c>;
			};

			uart1_rx_set {
				linux,phandle = <0x1d>;
				phandle = <0x1d>;

				pins_cmd_dat {
					pinmux = <0x4001>;
				};
			};

			uart1_rx_clear {
				linux,phandle = <0x1e>;
				phandle = <0x1e>;

				pins_cmd_dat {
					pinmux = <0x4000>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			uart1_tx_set {
				linux,phandle = <0x1f>;
				phandle = <0x1f>;

				pins_cmd_dat {
					pinmux = <0x4101>;
				};
			};

			uart1_tx_clear {
				linux,phandle = <0x20>;
				phandle = <0x20>;

				pins_cmd_dat {
					pinmux = <0x4100>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			uart2gpiodefault {
				linux,phandle = <0x21>;
				phandle = <0x21>;
			};

			uart2_rx_set {
				linux,phandle = <0x22>;
				phandle = <0x22>;

				pins_cmd_dat {
					pinmux = <0x2201>;
				};
			};

			uart2_rx_clear {
				linux,phandle = <0x23>;
				phandle = <0x23>;

				pins_cmd_dat {
					pinmux = <0x2200>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			uart2_tx_set {
				linux,phandle = <0x24>;
				phandle = <0x24>;

				pins_cmd_dat {
					pins = <0x2301>;
				};
			};

			uart2_tx_clear {
				linux,phandle = <0x25>;
				phandle = <0x25>;

				pins_cmd_dat {
					pinmux = <0x2300>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			pinconf_default {
				linux,phandle = <0x10>;
				phandle = <0x10>;
			};

			rtc32k_pins: rtc32k-pins {
				pins {
					pinmux = <0x1f01>;
					bias-disable;
				};
			};

			a04_camera_mclk_pins: camera-mclk-pins {
				pins {
					/* GPIO102 mode 1 is CMMCLK on MT8167. */
					pinmux = <0x6601>;
					drive-strength = <0x06>;
					bias-disable;
				};
			};

			audiodefault {
				linux,phandle = <0x4d>;
				phandle = <0x4d>;
			};

			audexampon {
				linux,phandle = <0x4e>;
				phandle = <0x4e>;
			};

			audexampoff {
				linux,phandle = <0x4f>;
				phandle = <0x4f>;
			};

			audi2s1mode0 {
			};

			audi2s1mode1 {
			};

			pmicclkmode0 {
			};

			pmicclkmode1 {
			};

			default {
			};

			eint0default {
				linux,phandle = <0x46>;
				phandle = <0x46>;

				pins_cmd_dat {
					pins = <0x800>;
					slew-rate = <0x00>;
					bias-disable;
				};
			};

			eint@0 {
				linux,phandle = <0x47>;
				phandle = <0x47>;

				pins_cmd_dat {
					pins = <0x800>;
					slew-rate = <0x00>;
					bias-disable;
				};
			};

			eintoutput0 {
				linux,phandle = <0x48>;
				phandle = <0x48>;

				pins_cmd_dat {
					pins = <0x800>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			eintoutput1 {
				linux,phandle = <0x49>;
				phandle = <0x49>;

				pins_cmd_dat {
					pins = <0x800>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			cfg_pmu_en_pull_dis {
				linux,phandle = <0x50>;
				phandle = <0x50>;

				combo_pins {
					pinmux = <0x400>;
					bias-disable;
				};
			};

			cfg_pmu_en_in_pulldown {
				linux,phandle = <0x51>;
				phandle = <0x51>;

				combo_pins {
					pinmux = <0x400>;
					bias-pull-down;
				};
			};

			cfg_rst_pull_dis {
				linux,phandle = <0x52>;
				phandle = <0x52>;

				combo_pins {
					pinmux = <0x700>;
					bias-disable;
				};
			};

			cfg_wifi_eint_in_pull_dis {
				linux,phandle = <0x53>;
				phandle = <0x53>;

				combo_pins {
					pinmux = <0x500>;
					slew-rate = <0x00>;
					bias-disable;
				};
			};

			cfg_wifi_eint_in_pullup {
				linux,phandle = <0x54>;
				phandle = <0x54>;

				combo_pins {
					pinmux = <0x500>;
					slew-rate = <0x00>;
					bias-pull-up = <0x00>;
				};
			};

			cfg_pcm_daiclk_pull_dis {
				linux,phandle = <0x55>;
				phandle = <0x55>;

				combo_pins {
					pinmux = <0x2401>;
					bias-disable;
				};
			};

			cfg_pcm_daipcmin_pull_dis {
				linux,phandle = <0x56>;
				phandle = <0x56>;

				combo_pins {
					pinmux = <0x2601>;
					bias-disable;
				};
			};

			cfg_pcm_daipcmout_pull_dis {
				linux,phandle = <0x57>;
				phandle = <0x57>;

				combo_pins {
					pinmux = <0x2701>;
					bias-disable;
				};
			};

			cfg_pcm_daisync_pull_dis {
				linux,phandle = <0x58>;
				phandle = <0x58>;

				combo_pins {
					pinmux = <0x2501>;
					bias-disable;
				};
			};

			cfg_gps_lna_pull_dis {
				linux,phandle = <0x59>;
				phandle = <0x59>;

				combo_pins {
					pinmux = <0xf00>;
					bias-disable;
				};
			};

			hdmi_pins_default {
				linux,phandle = <0x3b>;
				phandle = <0x3b>;
			};

			hdmi_pins_hpd {
				linux,phandle = <0x3c>;
				phandle = <0x3c>;
			};

			i2c0@0 {
				linux,phandle = <0x26>;
				phandle = <0x26>;

				pins1 {
					pinmux = <0x3a01 0x3b01>;
					bias-disable;
				};
			};

			i2c1@0 {
				linux,phandle = <0x27>;
				phandle = <0x27>;

				pins1 {
					pinmux = <0x3401 0x3501>;
					bias-disable;
				};
			};

			i2c2@0 {
				linux,phandle = <0x28>;
				phandle = <0x28>;

				pins1 {
					pinmux = <0x3c01 0x3d01 0x300 0x900 0xa00 0xb00>;
					bias-disable;
				};
			};

			mmc0default {
				linux,phandle = <0x32>;
				phandle = <0x32>;

				pins_cmd_dat {
					pinmux = <0x7801 0x7701 0x7601 0x7501 0x7101 0x7001 0x6f01 0x6e01 0x7301>;
					input-enable;
					bias-pull-up;
				};

				pins_clk {
					pinmux = <0x7401>;
					bias-pull-down;
				};

				pins_rst {
					pinmux = <0x7201>;
					bias-pull-up;
				};
			};

