			compatible = "mediatek,orientation";
		};

		led@0 {
			compatible = "mediatek,red";
			led_mode = <0x06>;
			data = <0x00>;
			pwm_config = <0x00 0x00 0x00 0x00 0x00>;
		};

		led@1 {
			compatible = "mediatek,green";
			led_mode = <0x06>;
			data = <0x01>;
			pwm_config = <0x00 0x00 0x00 0x00 0x00>;
		};

		led@2 {
			compatible = "mediatek,blue";
			led_mode = <0x06>;
			data = <0x02>;
			pwm_config = <0x00 0x00 0x00 0x00 0x00>;
		};

		led@3 {
			compatible = "mediatek,jogball-backlight";
			led_mode = <0x00>;
			data;
			pwm_config = <0x00 0x00 0x00 0x00 0x00>;
		};

		led@4 {
			compatible = "mediatek,keyboard-backlight";
			led_mode = <0x00>;
			data;
			pwm_config = <0x00 0x00 0x00 0x00 0x00>;
		};

		led@5 {
			compatible = "mediatek,button-backlight";
			led_mode = <0x00>;
			data;
			pwm_config = <0x00 0x00 0x00 0x00 0x00>;
		};

		led@6 {
			compatible = "mediatek,lcd-backlight";
			led_mode = <0x05>;
			data;
			pwm_config = <0x00 0x00 0x00 0x00 0x00>;
		};

		mtkfb@0 {
			compatible = "mediatek,MTKFB";
			mediatek,larb = <0x13>;
		};

		bat_meter {
			compatible = "mediatek,bat_meter";
		};

		BAT_NOTIFY {
			compatible = "mediatek,bat_notify";
		};

		bat_comm {
			compatible = "mediatek,battery";
			interrupt-parent = <0x12>;
			interrupts = <0x0b 0x01>;
			chgled-gpio = <0x12 0x0a 0x00>;
		};

		dumchar {
			compatible = "mediatek,mt8167-dummy_char";
		};

		extd_drv@0 {
			compatible = "mediatek,extd_dev";
		};

		flashlight_core {
			compatible = "mediatek,flashlight_core";
		};

		flashlights_lm3642 {
			compatible = "mediatek,flashlights_lm3642";
		};

		ice_debug {
			compatible = "mediatek,mt8167-ice_debug\0mediatek,mt8173-ice_debug";
			clocks = <0x05 0x4a>;
			clock-names = "ice_dbg";
		};

		isp_pipemgr {
			compatible = "mediatek,mt8167-isp_pipemgr";
		};

		isp_sysram {
			compatible = "mediatek,mt8167-isp_sysram";
		};

		mfgsys-async {
			compatible = "mediatek,mt8167-mfg-async";
			power-domains = <0x31 0x04>;
		};

		mfgsys-2d {
			compatible = "mediatek,mt8167-mfg-2d";
			power-domains = <0x31 0x05>;
		};

		mtee {
			compatible = "mediatek,mtee";
			clocks = <0x05 0x7b 0x05 0x65 0x3e 0x05 0x16 0x00 0x3e 0x00>;
			clock-names = "GCPU\0TRNG\0IMG_CLK\0SMI_COMMON\0IMG_SMI";
			pm-devs = <0x14 0x3d>;
			pm-names = "isp\0disp";
		};

		mtgpufreq {
			compatible = "mediatek,mt8167-gpufreq";
			reg-vgpu-supply = <0x2a>;
		};

		pseudo-m4u {
			compatible = "mediatek,mt8167-pseudo-m4u";
			iommus = <0x4a 0x01>;
			status = "disabled";
		};

		pseudo-m4u-larb0 {
			compatible = "mediatek,mt8167-pseudo-port-m4u";
			mediatek,larbid = <0x00>;
			iommus = <0x4a 0x00 0x4a 0x01 0x4a 0x02 0x4a 0x03 0x4a 0x04 0x4a 0x05 0x4a 0x05 0x4a 0x06 0x4a 0x07>;
			status = "disabled";
		};

		pseudo-m4u-larb1 {
			compatible = "mediatek,mt8167-pseudo-port-m4u";
			mediatek,larbid = <0x01>;
			iommus = <0x4a 0x08 0x4a 0x09 0x4a 0x0a 0x4a 0x0b 0x4a 0x0c 0x4a 0x0d 0x4a 0x0e 0x4a 0x0f 0x4a 0x10 0x4a 0x11 0x4a 0x12 0x4a 0x13 0x4a 0x14>;
			status = "disabled";
		};

		pseudo-m4u-larb2 {
			compatible = "mediatek,mt8167-pseudo-port-m4u";
			mediatek,larbid = <0x02>;
			iommus = <0x4a 0x15 0x4a 0x16 0x4a 0x17 0x4a 0x18 0x4a 0x19 0x4a 0x1a 0x4a 0x1b>;
			status = "disabled";
		};
	};

	lcm {
		compatible = "mediatek,lcm";
	};

	memory@00000000 {
		device_type = "memory";
		reg = <0x00 0x40000000 0x00 0x20000000>;
	};

	chosen {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		stdout-path = "serial0:921600n8";
		bootargs = "console=ttyS0,921600n8 console=tty0 earlycon=uart8250,mmio32,0x11005000 vmalloc=496M androidboot.hardware=mt8167 firmware_class.path=/vendor/firmware loop.max_part=7 acpi=off clk_ignore_unused pd_ignore_unused mem_sleep_default=s2idle";

		framebuffer0: framebuffer@be9c0000 {
			compatible = "simple-framebuffer";
			reg = <0x00 0xbe9c0000 0x00 0x1000000>;
			memory-region = <&framebuffer_reserved>;
			width = <800>;
			height = <1280>;
			stride = <3200>;
			format = "a8r8g8b8";
			status = "okay";
		};
	};

	cust_accel@0 {
		compatible = "mediatek,mmx8x5x";
		i2c_num = <0x01>;
		i2c_addr = <0x1d 0x00 0x00 0x00>;
		direction = <0x07>;
		power_id = <0xffff>;
		power_vol = <0x00>;
		firlen = <0x00>;
		is_batch_supported = <0x00>;
	};

	fixedregulator@0 {
		compatible = "regulator-fixed";
		regulator-name = "mmc_io";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		regulator-always-on;
	};

	a04_vproc_fixed: fixedregulator-vproc {
		compatible = "regulator-fixed";
		regulator-name = "a04-vproc-1v3";
		regulator-min-microvolt = <1300000>;
		regulator-max-microvolt = <1300000>;
		regulator-always-on;
		regulator-boot-on;
	};

	a04_backlight: backlight {
		compatible = "gpio-backlight";
		gpios = <0x12 0x01 0x00>;
		default-on;
		status = "okay";
	};

	charging-leds {
		compatible = "gpio-leds";

		charging-led {
			label = "a04br3:charging";
			gpios = <0x12 0x0a 0x00>;
			linux,default-trigger = "lc709203f-battery-charging";
			default-state = "off";
			retain-state-suspended;
		};
	};

	mmc_power: fixedregulator@1 {
		compatible = "regulator-fixed";
		regulator-name = "mmc_power";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		regulator-always-on;
	};

	mt6630_pmu: regulator-mt6630-pmu {
		compatible = "regulator-fixed";
		regulator-name = "mt6630-pmu";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		off-on-delay-us = <10000>;
		startup-delay-us = <100000>;
	};

	mt6630_pwrseq: mmc-pwrseq-mt6630 {
		compatible = "benesse,a04br3-mt6630-pwrseq";
		pinctrl-names = "default";
		pinctrl-0 = <&rtc32k_pins>;
		clocks = <&mt6392_rtc>;
		clock-names = "ext_clock";
		pmu-gpios = <0x12 0x04 0x00>;
		reset-gpios = <0x12 0x07 0x01>;
		post-power-on-delay-ms = <30>;
		power-off-delay-us = <10000>;
	};

	mt8167_audio_codec {
		compatible = "mediatek,mt8167-codec";
		clocks = <&a04_audio_clock 0x00>;
		clock-names = "bus";
		mediatek,afe-regmap = <0x4b>;
		mediatek,apmixedsys-regmap = <0x06>;
		mediatek,pwrap-regmap = <0x11>;
		mediatek,speaker-mode = <0x00>;
		mediatek,dmic-wire-mode = <0x01>;
		mediatek,headphone-cap-sel = <0x01>;
	};

	sound {
		compatible = "mediatek,mt8167-mt6392";
		mediatek,platform = <0x4b>;
		extcon = <0x5a>;
		pinctrl-names = "default\0extamp_on\0extamp_off";
		pinctrl-0 = <0x4d>;
		pinctrl-1 = <0x4e>;
		pinctrl-2 = <0x4f>;
		status = "okay";
	};

	mediatek,connectivity-combo {
		compatible = "mediatek,connectivity-combo";
		gpio_combo_pmu_en_pin = <0x12 0x04 0x00>;
		gpio_combo_rst_pin = <0x12 0x07 0x00>;
		gpio_wifi_eint_pin = <0x12 0x05 0x00>;
		gpio_pcm_daiclk_pin = <0x12 0x24 0x00>;
		gpio_pcm_daipcmin_pin = <0x12 0x26 0x00>;
		gpio_pcm_daipcmout_pin = <0x12 0x27 0x00>;
		gpio_pcm_daisync_pin = <0x12 0x25 0x00>;
		gpio_gps_lna_pin = <0x12 0x0f 0x00>;
		pinctrl-names = "gpio_pmu_en_pull_dis\0gpio_pmu_en_in_pulldown\0gpio_rst_pull_dis\0gpio_wifi_eint_in_pull_dis\0gpio_wifi_eint_in_pullup\0gpio_pcm_daiclk_pull_dis\0gpio_pcm_daipcmin_pull_dis\0gpio_pcm_daipcmout_pull_dis\0gpio_pcm_daisync_pull_dis\0gpio_gps_lna_pull_dis";
		pinctrl-0 = <0x50>;
		pinctrl-1 = <0x51>;
		pinctrl-2 = <0x52>;
		pinctrl-3 = <0x53>;
		pinctrl-4 = <0x54>;
		pinctrl-5 = <0x55>;
		pinctrl-6 = <0x56>;
		pinctrl-7 = <0x57>;
		pinctrl-8 = <0x58>;
		pinctrl-9 = <0x59>;
		interrupt-parent = <0x12>;
		interrupts = <0x05 0x08>;
	};
};
