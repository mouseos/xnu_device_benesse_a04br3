		scpsys@10006000 {
			compatible = "mediatek,mt8167-scpsys\0syscon\0simple-mfd";
			reg = <0x00 0x10006000 0x00 0x1000>;

			power-controller {
				compatible = "mediatek,mt8167-power-controller";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				#power-domain-cells = <0x01>;
				linux,phandle = <0x31>;
				phandle = <0x31>;

				/*
				 * DisplayInitDxe enables and verifies SMI_MM before
				 * Linux starts. Keep domain control independent from
				 * capture-clock consumers.
				 */
				power-domain@0 {
					reg = <0x00>;
					#power-domain-cells = <0x00>;
					mediatek,infracfg = <0x04>;
				};

				power-domain@1 {
					reg = <0x01>;
					#power-domain-cells = <0x00>;
				};

				power-domain@2 {
					reg = <0x02>;
					#power-domain-cells = <0x00>;
				};

				/* MFG_2D cannot acknowledge power-on on A04BR3 yet. */
				power-domain@4 {
					reg = <0x04>;
					status = "disabled";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#power-domain-cells = <0x01>;
					mediatek,infracfg = <0x04>;

					power-domain@5 {
						reg = <0x05>;
						#address-cells = <0x01>;
						#size-cells = <0x00>;
						#power-domain-cells = <0x01>;

						power-domain@6 {
							reg = <0x06>;
							#power-domain-cells = <0x00>;
							mediatek,infracfg = <0x04>;
						};
					};
				};

				power-domain@3 {
					reg = <0x03>;
					#power-domain-cells = <0x00>;
					mediatek,infracfg = <0x04>;
				};
			};
		};

