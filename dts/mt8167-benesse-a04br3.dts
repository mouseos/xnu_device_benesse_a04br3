		dsi: disp_dsi0@14012000 {
			compatible = "mediatek,mt8167-dsi\0mediatek,mt2701-dsi";
			reg = <0x00 0x14012000 0x00 0x1000>;
			interrupts = <0x00 0xab 0x08>;
			clocks = <0x16 0x16 0x16 0x17 &mipi_dphy>;
			clock-names = "engine\0digital\0hs";
			phys = <&mipi_dphy>;
			phy-names = "dphy";
			power-domains = <0x31 0x00>;
			benesse,a04br3-stock-phy-timing;
			status = "okay";

			#address-cells = <0x01>;
			#size-cells = <0x00>;

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@1 {
					reg = <0x01>;

					dsi_out: endpoint {
						remote-endpoint = <&panel_in>;
					};
				};
			};

			panel@0 {
				compatible = "benesse,a04br3-auo-wxga";
				reg = <0x00>;
				power-supply = <&a04_vgp2>;
				backlight = <&a04_backlight>;
				reset-gpios = <0x12 0x42 0x01>;
				standby-gpios = <0x12 0x43 0x00>;

				port {
					panel_in: endpoint {
						remote-endpoint = <&dsi_out>;
					};
				};
			};
		};

